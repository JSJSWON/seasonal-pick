# Record exact versions instead of a caret range.
#
# npm's default prefix is ^, which let `npm install next@16.4.3` widen the
# range to ^16.4.3 - a later `npm install` could then pull 16.5 unannounced.
# package-lock.json already pins what is installed, so this changes little in
# practice; it keeps package.json saying the same thing the lock does.
#
# Upgrades stay deliberate: name the version, see it in the diff.
save-exact=true
